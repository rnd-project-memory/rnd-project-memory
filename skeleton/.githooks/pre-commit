#!/usr/bin/env bash
# BLOCKING. The one rule a later edit cannot repair: once a secret is committed
# it is in git history on every clone. Install: git config core.hooksPath .githooks
set -u

# Identity: blocking, but only once the project lists who may commit, in .githooks/identity.allow.
# Commit metadata is published with the history and cannot be withdrawn, like a secret. An empty
# list means no check, so a project that has not opted in sees no false positive, and none
# tempts --no-verify. Checked before anything else, since a commit with nothing staged still
# records who made it.
allowlist=$(grep -vE '^[[:space:]]*(#|$)' .githooks/identity.allow 2>/dev/null | tr -d '[:blank:]')
if [ -n "$allowlist" ]; then
  for who in AUTHOR COMMITTER; do
    e=$(git var "GIT_${who}_IDENT" | sed -n 's/.*<\(.*\)>.*/\1/p' | tr '[:upper:]' '[:lower:]')
    ok=0
    while IFS= read -r pat; do
      pat=$(printf '%s' "$pat" | tr '[:upper:]' '[:lower:]')
      # shellcheck disable=SC2254
      case "$e" in $pat) ok=1; break;; esac
    done <<< "$allowlist"
    if [ "$ok" -eq 0 ]; then
      echo "BLOCKED: $(printf '%s' "$who" | tr '[:upper:]' '[:lower:]') <$e> is not listed in .githooks/identity.allow"
      echo "  Identity metadata is published with the history and cannot be withdrawn."
      echo "  Fix it, do not bypass it:  git config user.email <a listed address>"
      exit 1
    fi
  done
fi

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0
fail=0

# Data and credential files that should never be staged
while IFS= read -r f; do
  case "$f" in
    *.csv|*.parquet|*.pkl|*.pickle|*.xlsx|*.feather|*.h5|.env|.env.*|*.key|*.pem|*.p12|*.pfx)
      echo "BLOCKED: $f — data or credential file; see ai-sandbox/SOURCES.md"; fail=1;;
  esac
done <<< "$staged"

# Credential-shaped content
# Every alternative must match a credential *value*, not merely the name of one. A pattern that
# fires on `aws_secret_access_key` alone also fires on documentation about secret scanning —
# including this file — and a blocking check that cries wolf is answered with --no-verify, after
# which it is dead while still appearing installed.
core='(aws_secret_access_key\s*[=:]\s*\S{16,}|BEGIN [A-Z ]*PRIVATE KEY|xox[baprs]-|gh[pousr]_[A-Za-z0-9]{20,}|dapi[a-f0-9]{32}|AccountKey=[A-Za-z0-9+/=]{20,}|password\s*=\s*["\x27][^"\x27]{6,})'

# An organisation's own patterns live in .githooks/patterns.profile — one alternative per line.
# They are read as DATA and never sourced: this is the most sensitive check in the repository and
# it does not execute a file someone else supplies. The file is kept out of the release hash list
# for the same reason this one is in it — a hash means something only for a file installed
# verbatim, and this hook now is one.
#
# Two ways a supplied file could reach the core, both closed here. A blank line would contribute
# an empty alternative, which matches every line, blocks every clean commit and teaches
# --no-verify — the failure this hook cannot come back from. A malformed pattern would make grep
# exit 2, which `>/dev/null 2>&1` below cannot tell apart from "found nothing", silently
# disabling the scan while the hook still looks installed. So blank and comment lines are
# dropped, and a file that does not compile is discarded whole rather than folded in.
pat="$core"
extra=$(grep -vE '^[[:space:]]*(#|$)' .githooks/patterns.profile 2>/dev/null)
if [ -n "$extra" ]; then
  cand="${pat%)}|$(paste -sd'|' <<<"$extra"))"
  printf '' | grep -Eq "$cand" 2>/dev/null; rc=$?
  if [ "$rc" -lt 2 ]; then
    pat="$cand"
  else
    echo "WARNING: .githooks/patterns.profile is not a valid regex — using core patterns only"
  fi
fi

if git diff --cached -U0 | grep -nEi "$pat" >/dev/null 2>&1; then
  echo "BLOCKED: credential-shaped string in the staged diff:"
  git diff --cached -U0 | grep -nEi "$pat" | head -5 | sed 's/^/  /'
  fail=1
fi

command -v gitleaks >/dev/null 2>&1 && { gitleaks protect --staged --no-banner || fail=1; }

[ "$fail" -eq 1 ] && { echo; echo "Override only if you are certain: git commit --no-verify"; exit 1; }
exit 0
